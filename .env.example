# Telegram API credentials from https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Optional: directory used to stage downloads before upload (default: downloads)
DOWNLOAD_DIR=downloads

# Optional: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USERS=

# Optional: files larger than this (MB) are split into 7z volumes before
# upload; also the size of each volume. Keep under your upload limit
# (2000 for a normal account, up to 4000 for Premium). Default: 2000
PART_SIZE_MB=2000

# Optional: 7z compression level. 0 = store/just-chunk (default, fast),
# up to 9 = max compression.
SEVENZIP_LEVEL=0

# Optional: password-protect (and encrypt headers of) the 7z volumes.
SEVENZIP_PASSWORD=

# --- Google login (optional, for private files + better quota) ---
# Set to false to force anonymous public-link downloads only.
USE_GOOGLE_AUTH=true
# OAuth client JSON (Desktop app) from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the reusable login token is stored after `python login.py`.
GOOGLE_TOKEN_FILE=token.json
