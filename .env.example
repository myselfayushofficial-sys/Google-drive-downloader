# Telegram API credentials from https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Optional: directory used to stage downloads before upload (default: downloads)
DOWNLOAD_DIR=downloads

# Optional: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USERS=
